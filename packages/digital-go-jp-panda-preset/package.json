{
  "name": "@togana/digital-go-jp-panda-preset",
  "version": "0.0.37",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "pnpm run build",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "biome check --write --unsafe .",
    "lint": "biome lint .",
    "ci": "biome ci . && pnpm test",
    "prepublishOnly": "pnpm build"
  },
  "author": "togana",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tsconfig/node26": "26.0.2",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "4.1.12",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@digital-go-jp/design-tokens": "1.1.9",
    "@pandacss/types": "1.12.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/togana/digital-go-jp-panda-preset"
  }
}
