{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "styled-system/**"
      ]
    },
    "build:studio": {
      "dependsOn": [
        "example-studio#build"
      ],
      "outputs": [
        "dist/**",
        "styled-system/**"
      ]
    },
    "ci": {}
  }
}
